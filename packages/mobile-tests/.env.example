# Локальні перевизначення дефолтів з packages/core/src/config/env.ts.
# Значення тут — приклад під конкретну машину розробника (симулятор/AVD),
# тому .env не комітиться — скопіюй у .env і підстав своє.

# Має точно збігатися з існуючим simulator-ом: xcrun simctl list devices available
IOS_DEVICE_NAME=iPhone 17
IOS_PLATFORM_VERSION=26.5

# Має точно збігатися з реальним AVD: emulator -list-avds
ANDROID_AVD_NAME=Pixel_8
